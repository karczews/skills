#!/usr/bin/env bash
# Regenerate diagramize's generated files when one of their inputs, or one of the files
# themselves, is staged, so the commit carries files built from what it commits.
set -euo pipefail

inputs=(
  plugins/explain/skills/diagramize/references/mermaid-light.json
  plugins/explain/skills/diagramize/references/mermaid-dark.json
  'docs/diagramize/*.mmd'
  scripts/render-diagramize-preview.py
)
outputs=(
  plugins/explain/skills/diagramize/references/mermaid-light-frontmatter.yaml
  docs/diagramize/preview.html
  docs/diagramize/preview.md
)

if git diff --cached --quiet -- "${inputs[@]}" "${outputs[@]}"; then
  exit 0
fi

# The script reads the working tree, so the inputs there must be exactly what is staged.
unstaged="$(git diff --name-only -- "${inputs[@]}"; git ls-files --others --exclude-standard -- "${inputs[@]}")"
if [ -n "$unstaged" ]; then
  echo "pre-commit: these diagramize inputs differ from what is staged; stage or stash them first:" >&2
  echo "$unstaged" >&2
  exit 1
fi

echo "pre-commit: regenerating diagramize's generated files; hand edits to them are replaced"
python3 scripts/render-diagramize-preview.py
git add -- "${outputs[@]}"

if git diff --cached --quiet; then
  echo "pre-commit: nothing left to commit" >&2
  exit 1
fi
